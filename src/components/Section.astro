---
interface Props {
  cmd: string;
  id?: string;
}
const { cmd, id } = Astro.props;
---

<section id={id} class="section">
  <h2 class="cmd"><span class="ps1">$</span> {cmd}</h2>
  <div class="out"><slot /></div>
</section>

<style>
  .section { margin: 0 0 32px; }
  h2.cmd { font-size: 1em; font-weight: 400; margin: 0 0 10px; }
  .out { padding-left: 0; }
</style>
